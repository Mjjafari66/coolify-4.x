# Internal registry / mirror configuration for air-gapped Coolify
# Copy relevant lines to /data/coolify/source/.env on VM1

# --- Replace with your internal Harbor/Nexus address ---
REGISTRY_URL=harbor.dc.local

# Disable pulling from cdn.coolify.io / ghcr.io for updates
AUTOUPDATE=false

# Image paths WITHOUT tag — Coolify appends helper_version / realtime_version automatically
HELPER_IMAGE=harbor.dc.local/coollabsio/coolify-helper
REALTIME_IMAGE=harbor.dc.local/coollabsio/coolify-realtime

# Optional: CDN mirror inside your network (if you host coolify-cdn internally)
# CDN_URL=http://mirror.dc.local/coolify-cdn
# VERSIONS_URL=http://mirror.dc.local/coolify-cdn/coolify/versions.json

# Docker daemon on VM1 (/etc/docker/daemon.json) — example:
# {
#   "insecure-registries": ["harbor.dc.local"],
#   "registry-mirrors": ["https://harbor.dc.local/v2/dockerhub"]
# }
